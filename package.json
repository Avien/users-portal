{
  "name": "@users-portal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "start:angular": "nx serve users-portal-angular",
    "start:react": "concurrently -n ws,agent,react -c yellow,cyan,green 'MOCK_ORDERS_API_DELAY_MS=800 npm run mock:ws' 'npm run business-agent' 'VITE_BUSINESS_AGENT_ENDPOINT=http://localhost:8787/api/business-agent nx serve users-portal-react --port=4201'",
    "start:vue": "nx serve users-portal-vue",
    "start:shell": "npx serve apps/portal-shell --listen 4000",
    "mock:ws": "node tools/mock-orders-ws-server.mjs",
    "agent": "node tools/agent.mjs",
    "pr-review": "node tools/pr-review-agent.mjs",
    "business-agent": "tsx tools/business-agent-server.ts",
    "test:business-agent": "vitest run tools/business-agent-server.spec.ts",
    "validate": "npm run lint && npm run test",
    "validate:angular": "nx run-many -t lint test --projects=tag:framework:angular,tag:framework:shared",
    "validate:react": "tsc --noEmit -p apps/users-portal-react/tsconfig.app.json && nx run-many -t lint test --projects=tag:framework:react,tag:framework:shared",
    "validate:vue": "vue-tsc --noEmit -p apps/users-portal-vue/tsconfig.app.json && nx run-many -t lint test --projects=tag:framework:vue,tag:framework:shared",
    "build:angular": "npm run validate:angular && nx build users-portal-angular",
    "build:react": "npm run validate:react && nx build users-portal-react",
    "build:vue": "npm run validate:vue && nx build users-portal-vue",
    "build:prod": "npm run build:angular",
    "g:feature-domain": "npm run build:generators && nx g @portal/local-plugin:feature-domain",
    "build:generators": "tsc tools/generators/feature-domain/index.ts tools/generators/generators.utils.ts --module commonjs --moduleResolution node --target es2020 --outDir tools/generators/dist --skipLibCheck --esModuleInterop && cp -r tools/generators/feature-domain/files tools/generators/dist/feature-domain/"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~21.1.0",
    "@angular/common": "~21.1.0",
    "@angular/compiler": "~21.1.0",
    "@angular/core": "~21.1.0",
    "@angular/forms": "~21.1.0",
    "@angular/platform-browser": "~21.1.0",
    "@angular/platform-browser-dynamic": "~21.1.0",
    "@angular/router": "~21.1.0",
    "@anthropic-ai/sdk": "^0.104.1",
    "@module-federation/runtime": "^2.4.0",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/entity": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/vue-query": "^5.101.1",
    "@tanstack/vue-virtual": "^3.13.29",
    "pinia": "^3.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "rxjs": "~7.8.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.1.0",
    "@angular-devkit/schematics": "~21.1.0",
    "@angular/build": "~21.1.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "~21.1.0",
    "@angular/language-service": "~21.1.0",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@module-federation/vite": "^1.15.5",
    "@nx/angular": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/jest": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/react": "^22.5.4",
    "@nx/vite": "22.5.4",
    "@nx/web": "22.5.4",
    "@nx/workspace": "22.5.4",
    "@portal/local-plugin": "file:./tools/local-plugin",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.0.0",
    "@vue/test-utils": "^2.4.11",
    "angular-eslint": "^21.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-preset-angular": "~16.0.0",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.5.4",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5",
    "ws": "^8.20.0"
  }
}
